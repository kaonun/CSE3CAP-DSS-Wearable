# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real credentials.
#
# Firebase Console > Project settings > General > Your apps > SDK setup:
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In. Firebase Console > Authentication > Sign-in method > Google,
# then grab the OAuth client IDs from Google Cloud Console > Credentials.
# The Android client ID requires your SHA-1 fingerprint registered in Firebase
# (for EAS builds: `eas credentials` -> Android -> keystore -> SHA-1).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to "true" to run BLE/NFC against mocks instead of real hardware.
EXPO_PUBLIC_CONNECTIVITY_MOCK=
